{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "remotevib",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/ws", "/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "ROOM",
        "class_name": "VibeRoom"
      }
    ]
  },
  "exports": {
    "VibeRoom": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "observability": {
    "enabled": true,
    "traces": {
      "enabled": true
    }
  }
}
